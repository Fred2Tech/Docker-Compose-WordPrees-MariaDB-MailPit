# macOS / editors
.DS_Store
.idea/
.vscode/

# Docker data (databases, mails)
data/mariadb/
data/mailpit/

# WordPress: ignore core, config (passwords) and uploads
data/wordpress/*
!data/wordpress/wp-content/
data/wordpress/wp-content/*
data/wordpress/wp-content/uploads/
data/wordpress/wp-content/cache/
data/wordpress/wp-content/upgrade/
data/wordpress/wp-content/*.log

# Keep only your own code: mu-plugins, themes and plugins
!data/wordpress/wp-content/mu-plugins/
!data/wordpress/wp-content/themes/
!data/wordpress/wp-content/plugins/

# ...except the default themes/plugins shipped with WordPress
data/wordpress/wp-content/themes/twenty*/
data/wordpress/wp-content/plugins/akismet/
data/wordpress/wp-content/plugins/hello.php
data/wordpress/wp-content/plugins/index.php
data/wordpress/wp-content/themes/index.php

# Misc
.env
*.log
